rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validOrder(data) {
      return data.keys().hasOnly([
          'customerUid', 'productId', 'productTitle', 'amount', 'currency',
          'customerName', 'customerPhone', 'paymentMethod',
          'transactionId', 'senderPhone', 'status', 'createdAt'
        ])
        && data.keys().hasAll([
          'customerUid', 'productId', 'productTitle', 'amount', 'currency',
          'customerName', 'customerPhone', 'paymentMethod',
          'transactionId', 'senderPhone', 'status', 'createdAt'
        ])
        && data.customerUid == request.auth.uid
        && (
          (data.productId == 'flutter-basic-to-advanced'
            && data.productTitle == 'Flutter Basic to Advanced'
            && data.amount == 29900)
          ||
          (data.productId == 'ai-automation-zero-to-advanced'
            && data.productTitle == 'AI Automation: শূন্য থেকে অ্যাডভান্সড'
            && data.amount == 19900)
        )
        && data.currency == 'BDT'
        && data.customerName is string
        && data.customerName.size() >= 2
        && data.customerName.size() <= 100
        && data.customerPhone is string
        && data.customerPhone.matches('^01[3-9][0-9]{8}$')
        && data.paymentMethod in ['bkash', 'nagad', 'rocket']
        && data.transactionId is string
        && data.transactionId.size() >= 5
        && data.transactionId.size() <= 64
        && data.senderPhone is string
        && data.senderPhone.matches('^01[3-9][0-9]{8}$')
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    match /admins/{adminUid} {
      // Only project owners should manage this allow-list in Firebase Console.
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && validOrder(request.resource.data);
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
